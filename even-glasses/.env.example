# MentraOS app credentials — from console.mentra.glass (create an app, copy these).
PACKAGE_NAME=com.yourname.cantoflashcards
MENTRAOS_API_KEY=your_mentraos_api_key
PORT=3000

# Optional server-side defaults. These are normally set PER USER in the MentraOS
# app settings (see app_config.json), but you can hard-code a fallback here for a
# single-user self-hosted deployment.
#   CANTO_BASE_URL   e.g. https://canto-ank.silcoff-labs.ca
#   CANTO_API_TOKEN  generate one in the app's Settings → Even glasses
CANTO_BASE_URL=
CANTO_API_TOKEN=
