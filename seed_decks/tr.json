{
  "lang": "tr",
  "name": "Top 100 Turkish Words",
  "description": "The 100 most common words in Turkish — a fast start for beginners.",
  "items": [
    {
      "source_text": "to be, become",
      "target_text": "Olmak",
      "romanization": "",
      "notes": "This is the core verb for existence and states, functioning similarly to 'to be' in English when used with predicate nouns/adjectives.",
      "cefr_level": "A1",
      "labels": [
        "verb",
        "existence"
      ]
    },
    {
      "source_text": "I / me",
      "target_text": "Ben",
