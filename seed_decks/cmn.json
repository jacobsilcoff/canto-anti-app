{
  "lang": "cmn",
  "name": "Top 100 Mandarin Words",
  "description": "The 100 most common words in Mandarin — a fast start for beginners.",
  "items": [
    {
      "source_text": "I / me",
      "target_text": "我",
      "romanization": "wǒ",
      "notes": "Often used before a verb as the subject of a sentence.",
      "cefr_level": "A1",
      "labels": [
        "pronoun"
      ]
    },
    {
      "source_text": "you (singular)",
      "target_text": "你",
